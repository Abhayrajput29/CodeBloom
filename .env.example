# Supabase-connected app configuration (public client values; RLS is still mandatory)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new Supabase projects. This key is browser-safe only because RLS is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; use the publishable key above for new projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional and privileged: only for narrowly justified trusted server operations.
# Do not use from browser/client code; do not add NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional GitHub REST API token for higher rate limits.
# Public repository metadata can be fetched without this at lower unauthenticated limits.
# Server only; never expose to browser bundles or logs.
GITHUB_TOKEN=

# Optional non-secret base URL for Playwright targeting a running application.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# GitHub OAuth is intentionally not an application env requirement.
# For Supabase-managed GitHub login, configure Client ID/Secret in Supabase Auth settings.
